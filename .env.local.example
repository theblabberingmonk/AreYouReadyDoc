# Copy to .env.local and fill values. NEVER commit real values.
# Public (safe in the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only (never prefix with NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=
OPENCODE_GO_API_KEY=
# OpenAI-compatible chat completions endpoint for the key above.
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
AI_MODEL=deepseek-v4-pro
AI_ENABLED=false
AI_DAILY_LIMIT=20

# Keep sign-in and sign-up inside this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/library
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/library
